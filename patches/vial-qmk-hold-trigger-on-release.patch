+// Copyright 2026 dwarfsawman
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "keyboard_report_util.hpp"
+#include "keycode.h"
+#include "test_common.hpp"
+#include "action_tapping.h"
+#include "test_fixture.hpp"
+#include "test_keymap_key.hpp"
+
+using testing::_;
+using testing::InSequence;
+
+class ChordalHoldTriggerOnRelease : public TestFixture {};
+
+TEST_F(ChordalHoldTriggerOnRelease, same_hand_key_held_past_tapping_term_uses_hold) {
+    TestDriver driver;
+    InSequence sequence;
+    auto ctrl_n = KeymapKey(0, 1, 0, LCTL_T(KC_N));
+    auto v      = KeymapKey(0, 2, 0, KC_V);
+
+    set_keymap({ctrl_n, v});
+
+    EXPECT_NO_REPORT(driver);
+    ctrl_n.press();
+    run_one_scan_loop();
+    idle_for(237); // Reproduce the measured Ctrl/N-to-V interval.
+    v.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL));
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL, KC_V));
+    idle_for(TAPPING_TERM + 1);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL));
+    v.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    ctrl_n.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(ChordalHoldTriggerOnRelease, same_hand_key_released_within_tapping_term_uses_tap) {
+    TestDriver driver;
+    InSequence sequence;
+    auto ctrl_n = KeymapKey(0, 1, 0, LCTL_T(KC_N));
+    auto v      = KeymapKey(0, 2, 0, KC_V);
+
+    set_keymap({ctrl_n, v});
+
+    EXPECT_NO_REPORT(driver);
+    ctrl_n.press();
+    run_one_scan_loop();
+    idle_for(100);
+    v.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_N));
+    EXPECT_REPORT(driver, (KC_N, KC_V));
+    EXPECT_REPORT(driver, (KC_N));
+    v.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    ctrl_n.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(ChordalHoldTriggerOnRelease, opposite_hand_key_release_uses_permissive_hold) {
+    TestDriver driver;
+    InSequence sequence;
+    auto ctrl_n = KeymapKey(0, 1, 0, LCTL_T(KC_N));
+    auto v      = KeymapKey(0, MATRIX_COLS - 1, 0, KC_V);
+
+    set_keymap({ctrl_n, v});
+
+    EXPECT_NO_REPORT(driver);
+    ctrl_n.press();
+    run_one_scan_loop();
+    v.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL));
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL, KC_V));
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL));
+    v.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    ctrl_n.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(ChordalHoldTriggerOnRelease, thumb_key_release_uses_permissive_hold_for_mod_tap) {
+    TestDriver driver;
+    InSequence sequence;
+    auto ctrl_n    = KeymapKey(0, 1, 0, LCTL_T(KC_N));
+    auto thumb_key = KeymapKey(0, 0, 2, KC_SPC);
+
+    set_keymap({ctrl_n, thumb_key});
+
+    EXPECT_NO_REPORT(driver);
+    ctrl_n.press();
+    run_one_scan_loop();
+    thumb_key.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL));
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL, KC_SPC));
+    EXPECT_REPORT(driver, (KC_LEFT_CTRL));
+    thumb_key.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    ctrl_n.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(ChordalHoldTriggerOnRelease, thumb_layer_tap_keeps_its_own_hand_behavior) {
+    TestDriver driver;
+    InSequence sequence;
+    auto thumb_layer_tap = KeymapKey(0, 0, 2, LT(1, KC_SPC));
+    auto v               = KeymapKey(0, 2, 0, KC_V);
+
+    set_keymap({thumb_layer_tap, v});
+
+    EXPECT_NO_REPORT(driver);
+    thumb_layer_tap.press();
+    run_one_scan_loop();
+    v.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_SPC));
+    EXPECT_REPORT(driver, (KC_SPC, KC_V));
+    EXPECT_REPORT(driver, (KC_SPC));
+    v.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    thumb_layer_tap.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
+
+TEST_F(ChordalHoldTriggerOnRelease, flow_tap_still_forces_tap_after_recent_typing) {
+    TestDriver driver;
+    InSequence sequence;
+    auto u      = KeymapKey(0, 0, 0, KC_U);
+    auto ctrl_n = KeymapKey(0, 1, 0, LCTL_T(KC_N));
+
+    set_keymap({u, ctrl_n});
+
+    EXPECT_REPORT(driver, (KC_U));
+    EXPECT_EMPTY_REPORT(driver);
+    tap_key(u);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_REPORT(driver, (KC_N));
+    ctrl_n.press();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_NO_REPORT(driver);
+    idle_for(TAPPING_TERM + 1);
+    VERIFY_AND_CLEAR(driver);
+
+    EXPECT_EMPTY_REPORT(driver);
+    ctrl_n.release();
+    run_one_scan_loop();
+    VERIFY_AND_CLEAR(driver);
+}
